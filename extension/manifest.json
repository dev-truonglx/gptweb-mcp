{
  "manifest_version": 3,
  "name": "ChatGPT Local Filesystem MCP Bridge",
  "version": "1.0.1",
  "description": "Connects ChatGPT Web to your local filesystem using Model Context Protocol",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://localhost:8889/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
